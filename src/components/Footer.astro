---
import siteConfig from '../data/site-config';
import Button from './Button.astro';

const socialLinks = siteConfig.socialLinks || [];
---

<footer class="w-full max-w-5xl mx-auto pt-12 pb-10 sm:pt-24 sm:pb-14 flex flex-col gap-8">
    <div class="m-auto text-center flex flex-col gap-4">
        <div class="flex items-center gap-8 justify-center">
            <img class="footer__coffee" src="coffee.png" loading="lazy" decoding="async" alt="Lara Ferrer" />
            <h2 class="font-serif text-4xl text-center">Let's have a chat. Or a coffee break.</h2>
        </div>
        <Button class="w-fit-content m-auto" href="/contact">send me a message</Button>
    </div>
    <div class:list={['footer__border pt-6 flex flex-col gap-4 border-t', { 'sm:flex-row sm:justify-between sm:items-center': socialLinks.length > 0 }]}>
        <img class="footer__logo" src="logo.jpg" loading="lazy" decoding="async" alt="Lara Ferrer" />
        {
            socialLinks.length > 0 && (
                <div class="flex flex-wrap gap-x-4 gap-y-1">
                    {socialLinks.map((link) => (
                        <a
                            class="inline-flex items-center justify-center text-sm hover:underline hover:underline-offset-2"
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferer"
                        >
                            {link.text}
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</footer>
